{
  "name": "portal",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "1.0.3",
  "publisher": "s9y",
  "private": true,
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/s3hq4y/portal.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:portal.showPanel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portal",
          "title": "%view.container.title%",
          "icon": "resources/portal-activity.svg"
        }
      ]
    },
    "views": {
      "portal": [
        {
          "type": "webview",
          "id": "portal.panel",
          "name": "%view.panel.name%",
          "contextualTitle": "%view.panel.contextualTitle%",
          "retainContextWhenHidden": true
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "portal.tunnelProvider": {
          "type": "string",
          "enum": [
            "ngrok-reserved",
            "cloudflare-quick",
            "cloudflare-named",
            "custom"
          ],
          "enumDescriptions": [
            "%config.tunnelProvider.enum.ngrok%",
            "%config.tunnelProvider.enum.quick%",
            "%config.tunnelProvider.enum.named%",
            "%config.tunnelProvider.enum.custom%"
          ],
          "default": "cloudflare-quick",
          "description": "%config.tunnelProvider.desc%"
        },
        "portal.ngrokDomain": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ngrokDomain.desc%"
        },
        "portal.cloudflareDomain": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.cloudflareDomain.desc%"
        },
        "portal.customTunnelCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.customTunnelCommand.desc%"
        },
        "portal.customTunnelShell": {
          "type": "string",
          "enum": [
            "default",
            "powershell",
            "pwsh",
            "cmd",
            "bash"
          ],
          "default": "default",
          "markdownDescription": "%config.customTunnelShell.desc%"
        },
        "portal.customTunnelUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.customTunnelUrl.desc%"
        },
        "portal.customTunnelUrlPattern": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.customTunnelUrlPattern.desc%"
        },
        "portal.customTunnelReadyPattern": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.customTunnelReadyPattern.desc%"
        },
        "portal.customTunnelTimeoutMs": {
          "type": "number",
          "default": 30000,
          "markdownDescription": "%config.customTunnelTimeoutMs.desc%"
        },
        "portal.routeToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.routeToken.desc%"
        },
        "portal.localPort": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%config.localPort.desc%"
        },
        "portal.startOnActivation": {
          "type": "boolean",
          "default": true,
          "description": "%config.startOnActivation.desc%"
        },
        "portal.showCommandsInTerminal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.showCommandsInTerminal.desc%"
        },
        "portal.maxTransferBytes": {
          "type": "number",
          "default": 67108864,
          "markdownDescription": "%config.maxTransferBytes.desc%"
        },
        "portal.promptTemplates": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "title": "Name" },
              "text": { "type": "string", "title": "Template" }
            },
            "required": ["name", "text"]
          },
          "markdownDescription": "%config.promptTemplates.desc%"
        },
        "portal.agentInstructions": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.agentInstructions.desc%"
        }
      }
    },
    "commands": [
      {
        "command": "portal.start",
        "title": "%command.start%",
        "icon": "$(play)"
      },
      {
        "command": "portal.stop",
        "title": "%command.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "portal.showPanel",
        "title": "%command.settings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "portal.copyUrl",
        "title": "%command.copyUrl%",
        "icon": "$(copy)"
      },
      {
        "command": "portal.copyPrompt",
        "title": "%command.copyPrompt%",
        "icon": "$(comment)"
      },
      {
        "command": "portal.checkTunnel",
        "title": "%command.checkTunnel%",
        "icon": "$(check)"
      },
      {
        "command": "portal.installCloudflared",
        "title": "%command.installCloudflared%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "portal.installNgrok",
        "title": "%command.installNgrok%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "portal.setTunnelProvider",
        "title": "%command.setTunnelProvider%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "portal.setNgrokDomain",
        "title": "%command.setNgrokDomain%",
        "icon": "$(globe)"
      },
      {
        "command": "portal.setRouteToken",
        "title": "%command.setRouteToken%",
        "icon": "$(key)"
      },
      {
        "command": "portal.showLog",
        "title": "%command.showLog%",
        "icon": "$(output)"
      },
      {
        "command": "portal.showAgentTerminal",
        "title": "%command.showAgentTerminal%",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "portal.start",
          "when": "!portal.running"
        },
        {
          "command": "portal.stop",
          "when": "portal.running"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/extension.js --external:vscode --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/extension.js --external:vscode --sourcemap --watch",
    "package": "npm run build && vsce package --no-dependencies",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4"
  }
}
